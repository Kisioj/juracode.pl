// Konfiguracja Cloudflare Workers: strona statyczna serwowana z katalogu public/
{
  "name": "juracode",
  "compatibility_date": "2026-09-01",
  // Strona jest dostępna tylko pod juracode.pl (bez duplikatów na *.workers.dev)
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
